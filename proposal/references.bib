@article{rajasekharababu_evolution_2012,
	series = {2nd {International} {Conference} on {Communication}, {Computing} \& {Security} [{ICCCS}-2012]},
	title = {Evolution of {Degree} of {Purity} in {Programming} {Languages}},
	volume = {6},
	issn = {2212-0173},
	url = {https://www.sciencedirect.com/science/article/pii/S2212017312005877},
	doi = {10.1016/j.protcy.2012.10.042},
	abstract = {Pure method is a method, which does not have any side effects or the extent of the side effect is limited. Purity Analysis is the technique of determining pure methods. Purity information can be used to perform program analysis, specification, verification and optimization. The extent of side effects in a program can be expressed in terms of Degree of Purity. Degree of purity measures the side effects in different areas such as accessing of files, objects and variables, violation of programming constraints and possible exceptions. This paper proposes a model that measures the degree of purity of programming languages and implements it in scala. This allows us to determine concurrency in a program and execution in multi core machine.},
	urldate = {2026-11-12},
	journal = {Procedia Technology},
	author = {RajasekharaBabu, M. and Baby, Anu Soosan and Raveendran, Deepu and Joe, Aswathi},
