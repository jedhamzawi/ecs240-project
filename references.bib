% Bibliography for the project proposal.
% Cite with \cite{key}; only cited entries appear under "References Cited".
% Spec: at least 3 citations, at least 2 of them research papers.

% Example entries. BibTeX ignores '%' comments, so they're wrapped in
% @comment{...} instead. Copy an entry out of the block to use it.

@comment{
@article{ArticleKey,
  author  = {Lastname1, Firstname1 and Lastname2, Firstname2},
  title   = {Article Title},
  journal = {Journal Name},
  year    = {2024},
  doi     = {10.xxxx/xxxxx},
}

@inproceedings{ConferenceKey,
  author    = {Lastname, Firstname},
  title     = {Paper Title},
  booktitle = {Proceedings of the ACM SIGPLAN Conference on ...},
  year      = {2024},
  doi       = {10.xxxx/xxxxx},
}

@misc{WebsiteKey,
  author       = {Creator(s)},
  title        = {Page Title},
  howpublished = {\url{https://example.com/}},
  note         = {Accessed 2026-11-10},
}
}
